{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "characters": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "words": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uniqueWords": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "readingSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "topWords": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "word": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "word",
          "count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "characters",
    "words",
    "uniqueWords",
    "readingSeconds",
    "topWords"
  ],
  "additionalProperties": false
}
