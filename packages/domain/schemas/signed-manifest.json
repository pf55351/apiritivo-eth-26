{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "app": {
          "type": "string",
          "const": "apiperitivo"
        },
        "serviceId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "planId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "enum": [
            "text",
            "data",
            "utilities"
          ]
        },
        "provider": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "treasury": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "chainId": {
          "type": "number",
          "const": 43113
        },
        "token": {
          "type": "string",
          "const": "0x5425890298aed601595a70AB815c96711a31Bc65"
        },
        "priceAtomic": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2592000,
          "multipleOf": 2
        },
        "feeBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "operations": {
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text.analyze",
              "json.transform"
            ]
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "requestsPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "bodyBytes": {
              "type": "integer",
              "minimum": 256,
              "maximum": 131072
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 30000
            }
          },
          "required": [
            "requestsPerMinute",
            "concurrency",
            "bodyBytes",
            "timeoutMs"
          ],
          "additionalProperties": false
        },
        "terms": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "schemaVersion",
        "app",
        "serviceId",
        "planId",
        "name",
        "version",
        "description",
        "category",
        "provider",
        "treasury",
        "chainId",
        "token",
        "priceAtomic",
        "durationSeconds",
        "feeBps",
        "operations",
        "limits",
        "terms"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{130}$"
    }
  },
  "required": [
    "manifest",
    "signature"
  ],
  "additionalProperties": false
}
