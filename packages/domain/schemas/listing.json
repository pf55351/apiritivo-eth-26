{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "app": {
      "type": "string",
      "const": "apiperitivo"
    },
    "type": {
      "type": "string",
      "const": "service"
    },
    "planId": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "serviceId": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "manifestRef": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "category": {
      "type": "string",
      "enum": [
        "text",
        "data",
        "utilities"
      ]
    },
    "provider": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "priceAtomic": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2592000,
      "multipleOf": 2
    },
    "chainId": {
      "type": "number",
      "const": 43113
    },
    "token": {
      "type": "string",
      "const": "0x5425890298aed601595a70AB815c96711a31Bc65"
    }
  },
  "required": [
    "schemaVersion",
    "app",
    "type",
    "planId",
    "serviceId",
    "manifestRef",
    "name",
    "category",
    "provider",
    "priceAtomic",
    "durationSeconds",
    "chainId",
    "token"
  ],
  "additionalProperties": false
}
