# Copy to .env. Never commit private keys or batch credentials.
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3001
DATABASE_PATH=var/apiperitivo.sqlite
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Filled after pnpm deploy:fuji. No production funds.
MARKET_ADDRESS=
FUJI_PRIVATE_KEY=
PAYMENT_CONFIRMATIONS=2
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# Fund this testnet wallet with GLM. Used only by the issuer/worker.
ARKIV_PRIVATE_KEY=
# Public issuer address; must match ARKIV_PRIVATE_KEY when supplied.
ARKIV_ISSUER_ADDRESS=
# Bee API root supporting /bytes. Local Bee is a configuration default, not a mock.
SWARM_BEE_URL=http://localhost:1633
# Upload credential: 64 hex characters, no 0x. NOT a content reference.
SWARM_POSTAGE_BATCH_ID=
SWARM_ID_URL=https://swarm-id.snaha.net
# Provider signs public manifests. Can be the testnet deployer during the demo.
PROVIDER_PRIVATE_KEY=
TREASURY_ADDRESS=
# Separate issuer key for receipt signatures (Ethereum personal_sign).
RECEIPT_PRIVATE_KEY=
