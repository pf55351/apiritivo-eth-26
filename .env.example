# APIritivo Phase 1 — copy to apps/web/.env.local

# ---- Swarm ID (browser) ----
NEXT_PUBLIC_SWARM_ID_IFRAME_ORIGIN=https://swarm-id.snaha.net
NEXT_PUBLIC_SWARM_ID_APP_NAME=APIritivo
# Public Bee API used for manifest proof links and as download fallback.
# Default: https://api.gateway.ethswarm.org (the same gateway the Swarm ID proxy uploads through).
# A manifest is visible at <gateway>/bytes/<manifestRef>
NEXT_PUBLIC_SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
# Subsidised gateway: stamps uploads for identities that have no postage stamp/drive,
# so canUpload=true (uploadMode=subsidised). Same value the official Swarm ID demo uses.
# Set to "off" to require users' own stamps.
NEXT_PUBLIC_SWARM_SUBSIDISED_GATEWAY_URL=https://api.gateway.ethswarm.org/

# ---- Arkiv reads (browser + server) ----
# Leave empty to use the Tiramisu testnet default RPC
# (https://rpc.tiramisu.db-chain.testnet.arkiv.network)
NEXT_PUBLIC_ARKIV_RPC_URL=
# The only Arkiv owner whose entities the app trusts (listings, passes, receipts, grants).
# Arkiv is a public chain and anyone can write `app = apiritivo` attributes, so every read
# filters by this address. It MUST be the address of ARKIV_WRITER_PRIVATE_KEY below.
# Leave empty to use the shipped demo writer (0x401629d4c1A4C1A0Ffd14A089f798Dd29A94c09C).
NEXT_PUBLIC_ARKIV_WRITER_ADDRESS=

# ---- Arkiv server-side writer (SERVER ONLY, never NEXT_PUBLIC_) ----
# Optional RPC override for writes; defaults to NEXT_PUBLIC_ARKIV_RPC_URL / chain default
ARKIV_RPC_URL=
# The platform pays gas for every service published (Phase 1 trust model).
# The writer address is derived from the private key below (no separate variable needed).
# Current writer: 0x401629d4c1A4C1A0Ffd14A089f798Dd29A94c09C
# Fund it with testnet GLM: https://hub.arkiv.network/faucet
# Check balance:            https://tiramisu.explorer.arkiv.network/address/0x401629d4c1A4C1A0Ffd14A089f798Dd29A94c09C
#
# Private key (0x + 64 hex) matching the address above: the server signs every
# createEntity transaction with it. TESTNET ONLY — never reuse this key on mainnet
# or hold real funds on it. Copy this file to apps/web/.env.local to activate publishing;
# without it the app runs read-only and the dashboard shows "Arkiv writer not configured".
ARKIV_WRITER_PRIVATE_KEY=0x84bc712e1321f8efa3307b42dd63b0015096b2d2ec140f273530584397d31b91

# ---- Phase 2 payments (USDC on Avalanche Fuji, chain id 43113) ----
# Optional RPC override used by the server to verify payments; defaults to the public Fuji RPC.
AVALANCHE_FUJI_RPC_URL=
# Test funds: USDC https://faucet.circle.com/  ·  AVAX (gas) https://core.app/tools/testnet-faucet/
# APIritivoPayments contract (contracts/src/APIritivoPayments.sol), deployed on Fuji 2026-09-12:
# https://testnet.snowtrace.io/address/0x4e98f464dc8c667e3b0fd3092e0f2d4585702fa3  (owner = writer above, fee 0 bps). Set to empty to fall back to direct transfers:
# the app then pays providers directly. Once set, purchases go through `buy()` and the
# server verifies the Purchased event; the "On-chain payments" panels show contract + txs.
NEXT_PUBLIC_PAYMENTS_CONTRACT_ADDRESS=0x4e98f464dc8c667e3b0fd3092e0f2d4585702fa3

# ---- ENS (read-only) ----
# Chain used to resolve the ENS names providers link to their services: "sepolia" (default; ENSv2 beta, free names
# at https://app.ens.dev paid in mintable MockUSDC + Sepolia ETH gas) or "mainnet".
# Sepolia resolves through UniversalResolverV2 (0x4a18…3c70); override with NEXT_PUBLIC_ENS_UNIVERSAL_RESOLVER / NEXT_PUBLIC_ENS_APP_URL if needed.
NEXT_PUBLIC_ENS_CHAIN=sepolia
# Optional RPC overrides (browser / server); defaults to the chain's public RPC.
NEXT_PUBLIC_ENS_RPC_URL=
ENS_RPC_URL=
