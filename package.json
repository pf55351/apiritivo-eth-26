{
  "name": "apiritivo",
  "private": true,
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check . && turbo lint",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "dev:web": "bun --cwd apps/web dev",
    "test:contracts": "cd contracts && forge test",
    "build:contracts": "cd contracts && forge build",
    "call:service": "bun tools/call-service.ts",
    "demo:check": "bun --cwd tools demo:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
