  "cards": [
    {
      "dot": "cyan",
      "title": "Browser responsibilities",
      "items": [
        "Upload manifests and manage ACT on Swarm; read Arkiv directly.",
        "Sign USDC buy / claim; send tx hash, secret hash and encrypted secret to the API."
      ]
    },
    {
      "dot": "emerald",
      "title": "Access and execution",
      "items": [
        "Bearer = <passKey>.<secret>. Check entity, service, expiry block and keccak256(secret).",
        "Gateway resolves a manifest endpoint; no usable endpoint runs the built-in demo."
      ]
    },
    {
      "dot": "amber",
      "title": "Current trust boundary",
      "items": [
        "The server owns the Arkiv writer. Caller identity fields are unsigned.",
        "Sale lookup precedes two separate writes: pass, then receipt. This is not atomic."
      ]
    }
